# Public Supabase project values only (safe for the browser).
# Never put the service-role / secret key here or in any Vite-exposed variable.
# Copy this file to .env and fill in your project values.
# Prefer the publishable key (sb_publishable_...) or legacy anon (eyJ...).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
